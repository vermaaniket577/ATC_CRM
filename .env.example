# ==============================================================================
# APEX TELECOM CRM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Note: Copy this file to .env and replace placeholder values before deployment.
# NEVER commit production credentials or encryption keys into version control.
# ==============================================================================

# Application Environment
NODE_ENV=production
SPRING_PROFILES_ACTIVE=mysql
SERVER_PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=telecom_crm
DB_USER=telecom_app
DB_PASSWORD=your_secure_db_password_here
DB_ROOT_PASSWORD=your_secure_root_password_here
DB_CONNECTION_TIMEOUT=30000
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5

# JSON Web Token (JWT) Security
# Generate using: openssl rand -base64 64
JWT_SECRET=your_base64_encoded_256_bit_or_512_bit_secret_key_minimum_64_chars_here
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,https://crm.apextelecom.in

# React Frontend Client Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_ENABLE_MOCK_FALLBACK=false

# Regulatory & Security Compliance (DoT / TRAI / DPDPA 2023)
DOT_LICENSE_ID=DL-TELECOM-2024-9841
DPDPA_DATA_RETENTION_YEARS=5
AUDIT_LOG_RETENTION_DAYS=730

# Telecom SMS / Notification Gateway Credentials (Sandbox / Official API)
SMS_GATEWAY_ENDPOINT=https://api.sms-gateway.telecom.in/v2/send
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_placeholder
SMS_SENDER_ID=APEXTL

# Payment Gateway (Razorpay / BillDesk / Cashfree) Credentials
PAYMENT_GATEWAY_KEY_ID=rzp_live_placeholder_key_id
PAYMENT_GATEWAY_KEY_SECRET=rzp_live_placeholder_secret
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here

# AWS Cloud Infrastructure Settings (For ECS / EC2 / CloudWatch)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=apex-telecom-crm-docs-ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_placeholder
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_placeholder
CLOUDWATCH_LOG_GROUP=/aws/telecom-crm/production
